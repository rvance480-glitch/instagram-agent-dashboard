# Instagram Graph API (Business/Creator account linked to a Facebook Page).
# Leave these blank to run the dashboard in demo mode with sample data.
IG_ACCESS_TOKEN=
IG_USER_ID=
GRAPH_API_VERSION=v23.0

# Claude caption drafting. Leave blank to get placeholder captions.
ANTHROPIC_API_KEY=

# Flask session secret (any random string).
FLASK_SECRET_KEY=change-me
